type hal_micharge_default, domain;
type hal_micharge_default_exec, exec_type, file_type, vendor_file_type;
type hal_micharge_service, hal_service_type, service_manager_type;

binder_use(hal_micharge_default)
init_daemon_domain(hal_micharge_default)

allow hal_micharge_default hal_micharge_service:service_manager { add find };
